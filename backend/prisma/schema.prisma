generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model dedication {
  id            String    @id @default(uuid())
  songName      String    
  artistName    String
  albumImage    String
  spotifyLink   String
  dedication    String
  location      String
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
}

model user {
  id            String     @id @default(uuid())
  username      String     @unique
  email         String     @unique
  password      String
}